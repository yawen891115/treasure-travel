# Copy this file to .env and fill in your own values. NEVER commit .env to GitHub.
ANTHROPIC_API_KEY=
LLM_MODEL= # Set an actual model ID available in your account
# offline = free (hours from the dataset, distance-based travel time); google = live Google Maps data
MAPS_MODE=offline
GOOGLE_MAPS_API_KEY=
# Website settings
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Used only to estimate the evaluation cost (USD per million tokens); check current prices
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=

# Private production deployment (see DEPLOYMENT.md; local development may omit REDIS_URL)
AGENT_BACKEND=offline
APP_DOMAIN=example.com
REDIS_URL=
PLANNER_LIMITS_ENABLED=1
PLANNER_RATE=20
PLANNER_LOGIN_RATE=10
PLANNER_MAX_CONCURRENT=4
PLANNER_LEASE_SECONDS=180
# Live Maps only: manually verified catalog ID -> Google Place ID JSON file, mounted read-only
GOOGLE_PLACE_IDS_FILE=
